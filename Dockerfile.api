FROM python:3.12-slim
LABEL org.opencontainers.image.source="https://github.com/jatinxvats/schrodingers-librarian"

WORKDIR /app
ENV HF_HOME=/app/hf_cache

COPY requirements-api.txt .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements-api.txt

RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"
ENV HF_HUB_OFFLINE=1

COPY config.py .
COPY src/ src/
COPY api/ api/
COPY data/processed/chunks.jsonl data/processed/embeddings.npy data/processed/

RUN python -c "from src.index import ensure_index; print('indexed', ensure_index().count())"

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]